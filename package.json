{
  "name": "ge-app-mcp",
  "version": "0.3.1",
  "description": "Gemini Enterprise Model Context Protocol (MCP) Server",
  "main": "build/index.js",
  "bin": {
    "ge-app-mcp": "build/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "pretest": "npm run build",
    "test": "node --test \"tests/unit/*.test.mjs\" && node tests/test_mcp_client.mjs && node tests/test_mcp_scopes.mjs && node tests/test_smoke_api_contract.mjs && node tests/test_format_references.mjs",
    "test:configurations": "node tests/test_feature_management_consolidated.mjs && node tests/test_knowledge_graph.mjs && node tests/test_assistant_suite.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\""
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "gcp-metadata": "8.1.4",
    "gaxios": "7.1.5",
    "rimraf": "6.1.3",
    "glob": "13.0.6"
  },
  "keywords": [
    "mcp",
    "gemini",
    "google-cloud",
    "discovery-engine",
    "rag"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@google-cloud/discoveryengine": "^3.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
