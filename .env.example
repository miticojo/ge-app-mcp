# ==============================================================================
# Gemini Enterprise MCP Server - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root and replace placeholders with
# your actual Google Cloud Project configurations.
# ==============================================================================

# 🌐 1. Google Cloud Core Configurations
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=global                 # Optional. Defaults to "global" (supports "us", "eu", etc.)
GCP_COLLECTION=default_collection   # Optional. Defaults to "default_collection"

# 🔒 2. Quota & Billing Project Configuration
# Highly recommended if your Application Default Credentials (ADC) use a different 
# sandbox project for billing. This attributes costs and quotas to your target project.
GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project-id

# 🛡️ 3. Security Scopes (Least Privilege Gatekeeper)
# Comma-separated list of allowed operational scopes: search, admin, billing.
#   - Use 'search' for read-only user-facing RAG applications.
#   - Use 'search,admin' for SRE/DevOps automation or content indexing.
#   - Defaults to 'search,admin,billing' if omitted.
MCP_SCOPES=search,admin,billing

# ⏱️ 4. Long-running operations
# Maximum seconds a tool waits for a long-running operation before returning it as
# pending (poll with gemini_enterprise_get_operation). Defaults to 20.
MCP_LRO_WAIT_SECONDS=20

# 🌍 5. Remote mode (Streamable HTTP, e.g. Cloud Run behind Gemini Enterprise)
# stdio (default) uses your local ADC identity. http executes every call with the
# caller's own OAuth token (on-behalf-of) and never falls back to the server identity.
MCP_TRANSPORT=stdio
# PORT=8080
# Required in http mode: OAuth client IDs whose tokens are accepted (the client you
# registered for Gemini Enterprise).
# ALLOWED_OAUTH_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# Optional: restrict callers by email domain and Host header.
# ALLOWED_EMAIL_DOMAINS=example.com
# MCP_ALLOWED_HOSTS=ge-app-mcp-xxxxx.europe-west1.run.app
# Scopes accepted on incoming tokens (default: discoveryengine.readwrite, cloud-platform).
# ACCEPTED_OAUTH_SCOPES=https://www.googleapis.com/auth/discoveryengine.readwrite
