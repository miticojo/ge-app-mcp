# Model (Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GE_AGENT_MODEL=gemini-3.8-flash

# ge-app-mcp over stdio (default)
GCP_PROJECT=your-project-id
MCP_SCOPES=search,admin,billing

# Remote server instead of stdio (see README)
# GE_MCP_TRANSPORT=http
# GE_MCP_URL=https://your-service.run.app/mcp
# GE_MCP_TOKEN_STATE_KEY=ge_mcp_user_token
# GE_MCP_CLOUD_RUN_AUDIENCE=https://your-service.run.app
# GE_MCP_LOCAL_ADC=true
