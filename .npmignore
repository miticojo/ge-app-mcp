# Exclude configuration files
tsconfig.json
.DS_Store
.env*
!.env.example

# Exclude source files (only compiled JS in build/ is needed)
src/

# Exclude GitHub actions
.github/

# Exclude test files
tests/

# Exclude helper/example scripts
scripts/

# Exclude temporary or lock files
skills-lock.json
package-lock.json

# Container and design docs are not needed by npm consumers
Dockerfile
.dockerignore
docs/

# Examples are documentation, not part of the published server
examples/
